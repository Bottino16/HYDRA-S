# Copie para .env; nunca versione esse arquivo preenchido.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false
SIMULATE=true
# mysql (padrão) ou memory (demonstração explícita, perde dados ao reiniciar)
DB_MODE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sda
DB_PASSWORD=
# Apenas Docker Compose; use valor forte e diferente da senha do aplicativo.
DB_ROOT_PASSWORD=
DB_NAME=sda
DB_SSL=false
# Caminho absoluto para CA confiável; vazio usa autoridades do sistema.
DB_SSL_CA=
DB_CONNECT_TIMEOUT_MS=3000
READING_RETENTION_DAYS=90
READING_SAVE_SECONDS=10
ADMIN_USER=
ADMIN_PASSWORD=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Fase 1: usado somente com SIMULATE=false; nenhuma validação física realizada.
SERIAL_PORT=auto
# Assistente do Solo — chave somente no backend; nenhuma chamada real nos testes.
ANTHROPIC_API_KEY=
# Modelo obrigatório quando DEMO=false. Consulte os IDs oficiais e sua conta.
# Em 11/11/2026 a documentação lista, por exemplo, claude-sonnet-5-5.
# https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=
OPENWEATHER_API_KEY=

# Fase 2 — desenvolver/apresentar com SIMULATE=true até validação física.
SERIAL_RECONNECT_MS=3000
DATA_STALE_SECONDS=5
SCHEDULE_TIMEZONE=America/Fortaleza
# Preserve este diretório entre reinícios: impede repetir a ocorrência.
SCHEDULE_JOURNAL_DIR=.data/schedule-occurrences
SETTINGS_FILE=.data/device-settings.json
FLOW_PUMP_1_L_MIN=
FLOW_PUMP_2_L_MIN=
FLOW_PUMP_3_L_MIN=
# true: não consulta internet; false: proxy com cache (chave opcional acima).
WEATHER_OFFLINE=true
WEATHER_CACHE_SECONDS=600
WEATHER_TIMEOUT_MS=2000

# Demonstração usa respostas pré-definidas, sem IA/API real.
ASSISTANT_DEMO=false
ASSISTANT_MESSAGES_PER_HOUR=20
ASSISTANT_MESSAGES_PER_DAY=100
ASSISTANT_MESSAGE_MAX_CHARS=2000
ASSISTANT_MAX_TOKENS=700
ASSISTANT_HISTORY_MAX_CHARS=6000
ASSISTANT_TIMEOUT_SECONDS=60

# Fase 3.5 Etapa 1 — seleção explícita prevalece sobre ASSISTANT_DEMO legado.
# ollama: IA local, sem chave paga; demo: respostas prontas; claude: configuração anterior.
ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Janela pequena, prompt obrigatório preservado; não confundir tokens com caracteres.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=128
# Uma geração local por vez; concorrentes recebem aviso, sem fila nesta etapa.

# IA-1: continuações manuais por resposta (0 desativa, máximo 3). Cada uma consome a cota de mensagens.
ASSISTANT_MAX_CONTINUATIONS=2
